# ─── Сервер ──────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── База данных ─────────────────────────────────────────
# Если DATABASE_URL задан — используется PostgreSQL.
# Если не задан — используется SQLite (файл в DATA_DIR).
# DATABASE_URL=postgres://parking:parking_secret@localhost:5432/parking
# DB_TYPE=postgres  (авто: postgres если есть DATABASE_URL, иначе sqlite)

# ─── Пути (для SQLite / сидов) ───────────────────────────
# DATA_DIR=./data
# STATIC_DIR=./public

# ─── Бизнес-логика ───────────────────────────────────────
MIN_BOOKING_HOURS=1

# ─── Логирование ─────────────────────────────────────────
SERVICE_NAME=parking-backend
LOG_LEVEL=info

# ─── Сессии / Redis ──────────────────────────────────────
# Для масштабирования используйте Redis вместо MemoryStore.
# REDIS_URL=redis://localhost:6379
# SESSION_SECRET=replace-me
# SESSION_NAME=parking.sid
# SESSION_TTL_MS=86400000
# SESSION_COOKIE_SECURE=false

# ─── Release metadata ────────────────────────────────────
# RELEASE_VERSION=dev
# RELEASE_ENVIRONMENT=development
# INSTANCE_ID=local-dev
# TRUST_PROXY=false

# ─── Graceful shutdown ───────────────────────────────────
# SHUTDOWN_GRACE_MS=15000
# SHUTDOWN_MIN_DRAIN_MS=500
